{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口最小权限：配置三目录读写（含目录自身）+ VS Code 目录只读探测 + 连通性测试 HTTP（ARCHITECTURE §7）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "global-shortcut:default",
    "process:allow-restart",
    "updater:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" },
        { "path": "$HOME/.vscode/**" },
        { "path": "$HOME/.vscode-insiders/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" },
        { "path": "$HOME/.vscode/**" },
        { "path": "$HOME/.vscode-insiders/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME/.claude" },
        { "path": "$HOME/.claude/**" },
        { "path": "$HOME/.codex" },
        { "path": "$HOME/.codex/**" },
        { "path": "$HOME/.aiswitch" },
        { "path": "$HOME/.aiswitch/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1" },
        { "url": "http://127.0.0.1:*" }
      ]
    },
    "notification:default"
  ]
}
